+  console.error('❌ POSTGRES_URL environment variable is not set');
+  console.error('Please set POSTGRES_URL in your .env.local file');
+  process.exit(1);
+}
+
+console.log('🔧 Testing Neon Postgres Database Connection...\n');
+
+async function testDatabaseConnection() {
+  let client;
+  let db;
+
+  try {
+    // Test 1: Basic connection
+    console.log('1️⃣ Testing basic connection...');
+    client = postgres(POSTGRES_URL);
+    db = drizzle(client);
+    
+    // Simple query to test connection
+    const result = await client`SELECT version()`;
+    console.log('✅ Database connected successfully');
+    console.log(`   PostgreSQL version: ${result[0].version.split(' ')[0]} ${result[0].version.split(' ')[1]}\n`);
+
+    // Test 2: Check if User table exists
+    console.log('2️⃣ Checking User table structure...');
+    const tableInfo = await client`
+      SELECT column_name, data_type, is_nullable, column_default 
+      FROM information_schema.columns 
+      WHERE table_name = 'User' 
+      ORDER BY ordinal_position
+    `;
+    
+    if (tableInfo.length === 0) {
+      console.log('❌ User table does not exist');
+      console.log('   Run migrations first: npm run db:migrate');
+      return;
+    }
+    
+    console.log('✅ User table exists with columns:');
+    tableInfo.forEach(col => {
+      console.log(`   - ${col.column_name}: ${col.data_type} ${col.is_nullable === 'NO' ? 'NOT NULL' : 'NULLABLE'} ${col.column_default ? `DEFAULT ${col.column_default}` : ''}`);
+    });
+    console.log();
+
+    // Test 3: Test user operations
+    console.log('3️⃣ Testing user operations...');
+    
+    // Count existing users
+    const userCount = await db.select().from(user);
+    console.log(`   Current user count: ${userCount.length}`);
+
+    // Test creating a guest user (similar to createGuestUser function)
+    const testEmail = `test-guest-${Date.now()}@test.com`;
+    const testPassword = 'test-password-hash';
+    
+    console.log(`   Creating test user: ${testEmail}`);
+    
+    const insertResult = await db.insert(user).values({
+      email: testEmail,
+      password: testPassword
+    }).returning({
+      id: user.id,
+      email: user.email,
+    });
+    
+    console.log('✅ Test user created successfully:');
+    console.log(`   ID: ${insertResult[0].id}`);
+    console.log(`   Email: ${insertResult[0].email}`);
+
+    // Test reading the user back
+    const retrievedUser = await db.select().from(user).where(eq(user.email, testEmail));
